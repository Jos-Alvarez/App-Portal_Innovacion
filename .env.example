# =============================================================================
# .env.example — plantilla de variables de entorno del portal
# =============================================================================
#
# Este archivo SÍ se versiona en el repositorio, por lo que solo contiene
# marcadores de posición: no debe llevar host real, IP real, nombres reales de
# base de datos o de login, ni contraseñas.
#
# Uso:
#   1. Copiar este archivo a `.env.local`.
#   2. Reemplazar cada marcador por el valor real.
#   3. `.env.local` está en `.gitignore` y no se sube nunca al repositorio.
#
# Next.js carga `.env.local` automáticamente en todos los entornos excepto
# `test`. Ninguna de las variables listadas aquí es de navegador, por lo que
# ninguna lleva el prefijo `NEXT_PUBLIC_`.
#
# -----------------------------------------------------------------------------
# GRUPO A — requeridas ahora
# -----------------------------------------------------------------------------
#
# Forma de la cadena de conexión de Prisma + SQL Server:
#
#   sqlserver://HOST:1433;database=<db>;user=<user>;password=<password>;encrypt=true;trustServerCertificate=true
#
# Dos advertencias sobre este formato:
#
#   (a) Es estilo JDBC, separado por PUNTO Y COMA. No es el formato de URL de
#       Postgres (`postgresql://user:password@host:5432/db`) que suele
#       encontrarse en otros proyectos de Prisma. Los parámetros van después
#       del host como pares `clave=valor` separados por `;`.
#
#   (b) Un valor que contenga alguno de los caracteres  :  \  =  ;  /
#       debe ir envuelto en llaves. Esto aplica sobre todo a la contraseña:
#           password={mi;pass}
#
# Las dos bases de datos (la del portal y la shadow) ya están aprovisionadas a
# mano sobre la instancia corporativa de SQL Server, junto con el login del
# portal. Prisma nunca crea bases de datos: solo administra el esquema de una
# base que ya existe.

# Base de datos dedicada del portal. Es la única base que Prisma migra.
DATABASE_URL="sqlserver://HOST:1433;database=<db>;user=<user>;password=<password>;encrypt=true;trustServerCertificate=true"

# Base shadow dedicada que Prisma Migrate usa para calcular los diffs de
# migración. Vive en la MISMA instancia pero es una base DISTINTA de la
# anterior. Existe precisamente para que Prisma Migrate no cree ni elimine
# bases de datos por su cuenta en un servidor compartido.
SHADOW_DATABASE_URL="sqlserver://HOST:1433;database=<shadow_db>;user=<user>;password=<password>;encrypt=true;trustServerCertificate=true"

# -----------------------------------------------------------------------------
# GRUPO B — se necesitarán más adelante (comentadas: aún no tienen consumidor)
# -----------------------------------------------------------------------------
#
# Los nombres están listados para que este archivo documente la forma completa
# del entorno objetivo, sin fingir que ya está listo para usarse. Cada línea
# indica qué ítem del BACKLOG.md la consume y si depende de un tercero.

# --- Ítem #3 — Auth.js (sesión) --------------------------------------------
# Autoabastecibles: no dependen de TI, pero todavía no tienen consumidor.
# AUTH_SECRET="<secreto-generado-localmente>"
# AUTH_URL="<url-base-de-la-aplicacion>"

# --- Ítem #3 — Entra ID (OIDC) ---------------------------------------------
# BLOQUEADAS POR TI: dependen del registro de la aplicación en Entra ID.
# ENTRA_CLIENT_ID="<client-id>"
# ENTRA_CLIENT_SECRET="<client-secret>"
# ENTRA_TENANT_ID="<tenant-id>"
# ENTRA_ISSUER="<issuer-url>"
# ENTRA_REDIRECT_URI="<redirect-uri>"   # se registra una por entorno

# --- Ítems #9 / #10 — servicio interno de procesadores (FastAPI) -----------
# Autoabastecible más adelante; sin consumidor hasta que exista la ruta proxy.
# PROCESADORES_SERVICE_BASE_URL="<url-interna-del-servicio>"

# Token de servicio del portal hacia FastAPI. Su formato y su rotación son una
# decisión de arquitectura todavía abierta (se define en el ítem #9); no es un
# bloqueo de TI.
# PROCESADORES_SERVICE_TOKEN="<token-de-servicio>"

# --- Ítem #14 — notificación por correo best-effort ------------------------
# BLOQUEADAS POR TI / Área de Innovación: dependen de las credenciales de la
# API de correo.
#
# YA TIENEN CONSUMIDOR (`lib/correo/`), y siguen comentadas a propósito. El
# aviso es best-effort: si faltan, el portal registra la sugerencia igual y deja
# una línea de `console.warn` por cada envío omitido. No son un bloqueo para
# desplegar; son un bloqueo para que llegue el correo.
#
# MAIL_API_BASE_URL es el ORIGEN de la API, sin la ruta de envío: esa ruta la
# pone `lib/correo/servicio.ts` en una sola constante (`RUTA_ENVIO`), que es lo
# único que cambia el día que TI defina qué proveedor se usa.
# MAIL_API_BASE_URL="<url-de-la-api-de-correo>"
# MAIL_API_KEY="<api-key>"
# MAIL_FROM_ADDRESS="<remitente>"

# Buzón del Área de Innovación: el único destinatario del aviso. Es una cuenta
# de área y no la de una persona — el ítem #15 le da el panel, este le da el
# aviso, y ninguno de los dos debe depender de quién ocupa el puesto.
# MAIL_INNOVACION_ADDRESS="<correo-del-area-de-innovacion>"
