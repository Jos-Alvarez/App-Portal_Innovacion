<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS site configuration for the `procesadores` deployable (FastAPI).

  THIS FILE BELONGS TO THE OTHER REPOSITORY. It lives here only so both halves
  of the deployment system are designed and reviewed together; on deploy it is
  copied to the root of the `procesadores` release directory (the repository at
  T:\API-Portal). It is not consumed by the portal.

  Note for anyone editing this file: an XML comment may not contain two
  consecutive hyphens, so command-line flags are written in prose here.

  ==========================================================================
   THE SITE BINDING IS THE SECURITY BOUNDARY - READ THIS FIRST
  ==========================================================================

  This site MUST be bound to `127.0.0.1:8000` and to nothing else:

      Binding: http  127.0.0.1:8000  (no hostname, no other IP, no HTTPS)

  That single binding is what makes the internal processor endpoint
  unreachable from outside the host, which is the network-isolation
  requirement backlog item #0 deferred and item #9 could not start without.
  A loopback binding is stronger than a firewall rule for the same reason a
  locked door beats a "do not enter" sign: the socket never listens on an
  external interface, so there is no rule for anyone to relax later.

  A Windows Firewall rule blocking inbound TCP 8000 is still worth adding, as
  defence in depth. It is not the mechanism.

  Because the binding is loopback, this site is plain HTTP by design. The
  traffic never leaves the machine. The service's own bearer-token
  authentication (`TOKEN_SERVICIO`, checked by an ASGI middleware before a
  single byte of body is read) still applies to every request.

  ==========================================================================
   PREREQUISITES
  ==========================================================================

  1. HttpPlatformHandler installed (see the portal's web.config).
  2. The virtual environment already created from the locked dependency set,
     so `.venv` exists in the release directory.
  3. The application pool identity needs read+execute on the release directory,
     write on the log directory, and write on the temp directory the service
     uses for per-request working files.
  4. `TOKEN_SERVICIO` must be set and non-empty. The service fails closed at
     package-import time if it is not. That is intended, not a bug to work
     around here.
-->
<configuration>
  <system.webServer>

    <handlers>
      <remove name="httpPlatformHandler" />
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <!--
      The virtualenv interpreter is invoked directly rather than through
      `uv run`. `uv run` re-resolves the environment on every start, which is
      the right behaviour for a developer and the wrong one for a service: a
      restart at 3 a.m. should replay the exact interpreter and packages the
      release was built and tested with, not whatever resolution succeeds that
      night.

      ONE WORKER, and no Gunicorn (ADR 0012). `EJECUCIONES_MAX` is the
      service's only concurrency knob, and a second Uvicorn worker would
      silently double the ceiling that ADR set. HttpPlatformHandler starts
      exactly one process, so the invariant holds by construction rather than
      by remembering not to pass a flag.

      The host argument below pins Uvicorn to 127.0.0.1, which is stricter
      than the README's canonical 0.0.0.0 invocation and deliberately so: it
      makes the loopback boundary true at the socket as well as at the IIS
      binding.

      startupTimeLimit is generous because the first import loads openpyxl and
      the child-process machinery on a host shared with SQL Server.
    -->
    <httpPlatform processPath="T:\sites\procesadores\current\.venv\Scripts\python.exe"
                  arguments="-m uvicorn app.main:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT%"
                  stdoutLogEnabled="true"
                  stdoutLogFile="T:\sites\procesadores\logs\procesadores-stdout.log"
                  startupTimeLimit="120"
                  startupRetryCount="10"
                  requestTimeout="00:05:00"
                  forwardWindowsAuthToken="false">
      <environmentVariables>
        <!--
          Spawn is required (app/arranque.py fixes the multiprocessing start
          method and refuses to run otherwise). Nothing to configure here; the
          note exists so nobody "helpfully" adds a fork-related tweak.

          PYTHONUNBUFFERED makes the service's structured log lines reach
          stdoutLogFile as they happen instead of when a buffer fills. Without
          it, the log of a crashed process can end mid-incident.
        -->
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />

        <!--
          TOKEN_SERVICIO, EJECUCIONES_MAX and TIMEOUT_EJECUCION are NOT set
          here. TOKEN_SERVICIO is a secret and this file is versioned in Git;
          the deploy script injects the environment from the master secret
          file outside the release directory. TIMEOUT_EJECUCION must stay
          strictly below the portal's 2-minute cutoff, and the service
          validates that itself at startup and refuses to boot otherwise.
        -->
      </environmentVariables>
    </httpPlatform>

    <security>
      <requestFiltering removeServerHeader="true">
        <!--
          Same ceiling as the portal, and it has to be: the portal streams the
          request body straight through without re-encoding it, so whatever
          IIS accepts at the front door must also be accepted at this one.
          If these two numbers ever drift apart, uploads fail at the second
          hop with an error the portal cannot explain.
        -->
        <requestLimits maxAllowedContentLength="314572800" />
      </requestFiltering>
    </security>

    <!--
      The service answers with a typed error vocabulary that the portal maps
      into `evento_uso` rows. If IIS replaced those responses with its own
      error pages, the portal would record the wrong error type, or none.
    -->
    <httpErrors existingResponse="PassThrough" />

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <!--
          No HSTS: this site is loopback-only plain HTTP by design, and an
          HSTS header on 127.0.0.1 would apply to every other local service.
        -->
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
