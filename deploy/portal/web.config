<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS site configuration for the `portal` deployable (Next.js).

  This file belongs at the ROOT of a release directory, next to the standalone
  `server.js` that `next build` emits when `next.config.ts` sets
  `output: "standalone"`. The IIS site's physical path points at the `current`
  junction, so this file travels with every release and is versioned in Git.

  ==========================================================================
   PREREQUISITES - this file does nothing without them
  ==========================================================================

  1. HttpPlatformHandler must be installed on the host. It is NOT present
     today (the machine has ARR, the ASP.NET Core Module and Web Deploy).
     Without it, IIS returns 500.19 on the `handlers` section below.
  2. The site must have an HTTPS binding with a valid certificate. Auth.js
     issues its session cookie with the `__Secure-` prefix in production and
     browsers reject that cookie over plain HTTP, so the login does not merely
     degrade without TLS: it does not work at all.
  3. The application pool identity needs read+execute on the release
     directory, write on the log directory, and network access to SQL Server.
     The connection uses a SQL login, so no Kerberos delegation is involved.
  4. The release must contain `.next/static` and `public` copied INTO the
     standalone output. `next build` does not copy them; the deploy script
     must. Without that step the app boots and serves unstyled pages.

  ==========================================================================
   WHAT IS DELIBERATELY NOT HERE
  ==========================================================================

  Content-Security-Policy, X-Frame-Options, X-Content-Type-Options and
  Referrer-Policy are NOT set here. They are application semantics, and this
  repository has a test suite that can assert them; a header defined in IIS is
  invisible to that suite and to anyone reading the code. They belong in
  `next.config.ts` under `headers()`. Only the two headers that genuinely
  belong to the TLS-terminating layer are set below.

  Static assets are served by Node, not by IIS. Letting IIS serve `/_next/*`
  directly would be marginally faster and would introduce a second source of
  truth for cache headers and asset paths. Not worth it at this scale.

  Note for anyone editing this file: an XML comment may not contain two
  consecutive hyphens, so command-line flags are written in prose here.
-->
<configuration>
  <system.webServer>

    <!--
      Every request goes to the platform process. `requireAccess="Script"` is
      what HttpPlatformHandler expects; `path="*" verb="*"` is deliberate.
      Partial handler mappings are how half-proxied sites happen.
    -->
    <handlers>
      <remove name="httpPlatformHandler" />
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <!--
      processPath is the absolute path to node.exe as installed on this host
      (verified: C:\Program Files\nodejs\node.exe). It is absolute on purpose:
      resolving `node` through PATH makes the running version depend on the
      environment of whichever account started the pool.

      startupTimeLimit is raised from the 20 s default to 120 s. This host also
      runs SQL Server, so a cold start that includes loading the Prisma client
      can be slow under load. A too-short limit turns a slow boot into a
      restart loop.

      requestTimeout is raised from the 2 min default to 5 min. The portal's
      own processor proxy cuts at exactly 2 minutes. If IIS also cut at 2
      minutes, the two deadlines would race and the user would sometimes get
      an IIS timeout page instead of the app's typed error. The app must
      always be the one that decides it gave up.
    -->
    <httpPlatform processPath="C:\Program Files\nodejs\node.exe"
                  arguments=".\server.js"
                  stdoutLogEnabled="true"
                  stdoutLogFile="T:\sites\portal\logs\portal-stdout.log"
                  startupTimeLimit="120"
                  startupRetryCount="10"
                  requestTimeout="00:05:00"
                  forwardWindowsAuthToken="false">
      <environmentVariables>
        <environmentVariable name="NODE_ENV" value="production" />

        <!--
          HttpPlatformHandler picks a free port, exposes it as
          %HTTP_PLATFORM_PORT%, and proxies to it. Next's standalone server
          reads PORT, so this is the whole wiring.
        -->
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />

        <!--
          Next's standalone server binds 0.0.0.0 unless HOSTNAME says
          otherwise. Pinning it to loopback means the Node process is
          unreachable from the network even if the IIS binding were later
          misconfigured. IIS is the only way in, by construction.
        -->
        <environmentVariable name="HOSTNAME" value="127.0.0.1" />
      </environmentVariables>
    </httpPlatform>

    <security>
      <requestFiltering removeServerHeader="true">
        <!--
          The IIS default is 30000000 bytes (about 28.6 MB). The processor
          contract allows up to `entradas_max` files of `tamano_max` each
          (10 x 25 MB today), and the portal's proxy forwards the body without
          buffering it. With the default in place, a legitimate multi-file
          upload would be rejected by IIS with a 404.13 before the app ever
          saw it, and the app's own typed error vocabulary would never get the
          chance to explain why.

          300 MB = 250 MB of payload plus multipart overhead and headroom.
          This is a ceiling, not a policy: the real per-file and per-request
          limits are enforced by the application, which is where they belong.
        -->
        <requestLimits maxAllowedContentLength="314572800" />
      </requestFiltering>
    </security>

    <!--
      PassThrough is not optional here. Without it IIS replaces any response
      with a status of 400 or above and an empty body by its own error page,
      which would silently destroy the designed 403 screen (DESIGN.md), the
      login redirects, and every typed JSON error the API returns.
    -->
    <httpErrors existingResponse="PassThrough" />

    <httpProtocol>
      <customHeaders>
        <!--
          This removes the header IIS itself may add. Next emits its own
          `X-Powered-By: Next.js` separately, and that one must be turned off
          at the framework level with `poweredByHeader: false` in
          next.config.ts, which is NOT set there yet. Stripping it here would
          work, but it would hide an application default instead of changing
          it, and the next person would not know which layer to trust.
        -->
        <remove name="X-Powered-By" />

        <!--
          HSTS belongs to the layer that terminates TLS, which is this one.

          max-age is 1 year. `includeSubDomains` is intentionally ABSENT: on an
          internal corporate DNS name, asserting HSTS for every sibling
          hostname under the same domain would affect services this project
          does not own. Add it only after confirming every subdomain is HTTPS.

          Do not enable this until the certificate is installed and verified.
          HSTS is remembered by the browser: publishing it from a host that
          later loses its certificate locks users out until max-age expires.
        -->
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
